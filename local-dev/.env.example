# =============================================================================
# Notes on other environment variables
# =============================================================================
#
# The following variables are set directly in docker-compose.yml and do not
# need to be overridden here for a standard local setup:
#
#   NAIS_TOKEN_INTROSPECTION_ENDPOINT  → http://texas-backend:3000/api/v1/introspect
#   NAIS_TOKEN_ENDPOINT                → http://texas-backend:3000/api/v1/token (backend)
#                                        http://texas-frontend:3000/api/v1/token/exchange (frontend)
#                                        http://texas-data-collector:3000/api/v1/token (collector)
#   TPT_BACKEND_URL                    → http://tpt-backend:8080
#   TPT_BACKEND_TARGET                 → api://tpt-backend-local/.default
#   NAIS_DATABASE_TPT_BACKEND_TPT_JDBC_URL → jdbc:postgresql://postgres:5432/tpt?user=tpt&password=tpt
#   NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD → neo4j:7687 / neo4j / password
#   AZURE_OPENID_CONFIG_ISSUER (data-collector) → http://mock-oauth2-server:8080/azuread
#   ADMIN_GROUPS                       → 00000000-0000-0000-0000-000000000001
#                                        (this UUID is injected into the groups claim by
#                                         mock-oauth2-server for every login — all users
#                                         are admins locally)
