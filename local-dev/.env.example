# =============================================================================
# TPT Local Dev — Environment Variables
# =============================================================================
# Copy this file and adjust as needed. Most values work out of the box for
# Mode B (Docker Compose). Mode A (dev servers) does not require this file.
#
# Usage:
#   cp .env.example .env
#   docker compose --env-file .env up --build
# =============================================================================

# =============================================================================
# Required for Mode B (Docker Compose full stack build)
# =============================================================================

# GitHub Personal Access Token with read:packages scope.
# Required to build tpt-frontend (pulls private npm packages from npm.pkg.github.com).
# Generate at: https://github.com/settings/tokens
NODE_AUTH_TOKEN=

# =============================================================================
# tpt-data-collector — GitHub App credentials
# =============================================================================
# Without these, the data-collector starts but cannot process GitHub webhooks
# or authenticate incoming requests from tpt-backend. Safe to leave as dummy
# for local dev unless you are testing the GitHub integration specifically.

GITHUB_APP_ID=dummy
GITHUB_APP_INSTALLATION_ID=dummy

# RSA private key in PEM format (single line, newlines as \n)
GITHUB_APP_PRIVATE_KEY=dummy

# Secret used to validate incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=local-webhook-secret

# =============================================================================
# GCVE enrichment (optional)
# =============================================================================
# tpt-backend fetches CVE enrichment data from db.gcve.eu.
# Without an API key you may be rate-limited. Leave empty to use the public tier.

GCVE_API_URL=https://db.gcve.eu/api
GCVE_API_KEY=

# =============================================================================
# Notes on other environment variables
# =============================================================================
#
# The following variables are set directly in docker-compose.yml and do not
# need to be overridden here for a standard local setup:
#
#   NAIS_TOKEN_INTROSPECTION_ENDPOINT  → http://texas-backend:3000/api/v1/introspect
#   NAIS_TOKEN_ENDPOINT                → http://texas-backend:3000/api/v1/token (backend)
#                                        http://texas-frontend:3000/api/v1/token/exchange (frontend)
#   TPT_BACKEND_URL                    → http://tpt-backend:8080
#   TPT_BACKEND_SCOPE                  → api://tpt-backend-local/.default
#   NAIS_DATABASE_TPT_BACKEND_TPT_JDBC_URL → jdbc:postgresql://postgres:5432/tpt?user=tpt&password=tpt
#   KAFKA_BROKERS                      → kafka:9092
#   NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD → neo4j:7687 / neo4j / password
#   AZURE_OPENID_CONFIG_ISSUER (data-collector) → http://mock-oauth2-server:8080/azuread
#   ADMIN_GROUPS                       → 00000000-0000-0000-0000-000000000001
#                                        (this UUID is injected into the groups claim by
#                                         mock-oauth2-server for every login — all users
#                                         are admins locally)
#
# Auth keys (Texas JWK, mock-oauth2-server config) are embedded directly in
# docker-compose.yml from local-dev/keys/. They are test-only, non-secret.
