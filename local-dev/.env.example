# =============================================================================
# TPT Local Dev — Environment Variables
# =============================================================================
# Copy this file and adjust as needed. Most values work out of the box for
# Mode B (Docker Compose). Mode A (dev servers) does not require this file.
#
# Usage:
#   cp .env.example .env
#   docker compose --env-file .env up --build
# =============================================================================

# =============================================================================
# Required for Mode B (Docker Compose full stack build)
# =============================================================================

# GitHub Personal Access Token with read:packages scope.
# Required to build tpt-frontend (pulls private npm packages from npm.pkg.github.com).
# Generate at: https://github.com/settings/tokens
NODE_AUTH_TOKEN=

# =============================================================================
# tpt-data-collector — GitHub App credentials
# =============================================================================
# Without these, the data-collector starts but cannot process GitHub webhooks
# or authenticate incoming requests from tpt-backend. Safe to leave as dummy
# for local dev unless you are testing the GitHub integration specifically.

GITHUB_APP_ID=dummy
GITHUB_APP_INSTALLATION_ID=dummy

# RSA private key in PEM format (single line, newlines as \n)
GITHUB_APP_PRIVATE_KEY=dummy

# Secret used to validate incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=local-webhook-secret

# =============================================================================
# GCVE enrichment (optional)
# =============================================================================
# tpt-backend fetches CVE enrichment data from db.gcve.eu.
# Without an API key you may be rate-limited. Leave empty to use the public tier.

GCVE_API_URL=https://db.gcve.eu/api
GCVE_API_KEY=

# =============================================================================
# Texas sidecar — local dev RSA signing key (test-only, not a secret)
# =============================================================================
