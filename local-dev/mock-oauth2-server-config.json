{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "azuread",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "subject",
          "match": "^admin$",
          "claims": {
            "aud": "tpt-frontend-local",
            "preferred_username": "${subject}",
            "name": "${subject}",
            "NAVident": "${subject}",
            "oid": "00000000-0000-0000-0000-000000000099",
            "tid": "62366534-1ec3-4962-8869-9b5535279d0b",
            "groups": ["00000000-0000-0000-0000-000000000001"],
            "scp": "defaultaccess",
            "azp": "${clientId}"
          }
        },
        {
          "requestParam": "subject",
          "match": ".*",
          "claims": {
            "aud": "tpt-frontend-local",
            "preferred_username": "${subject}",
            "name": "${subject}",
            "NAVident": "${subject}",
            "oid": "00000000-0000-0000-0000-000000000099",
            "tid": "62366534-1ec3-4962-8869-9b5535279d0b",
            "groups": [],
            "scp": "defaultaccess",
            "azp": "${clientId}"
          }
        },
        {
          "requestParam": "requested_token_use",
          "match": "on_behalf_of",
          "claims": {
            "aud": "tpt-backend-local"
          }
        },
        {
          "requestParam": "scope",
          "match": "api://local.appsec.tpt-data-collector/.default",
          "claims": {
            "aud": "tpt-data-collector-local",
            "idtyp": "app",
            "azp_name": "dev-gcp:appsec:tpt-backend"
          }
        },
        {
          "requestParam": "scope",
          "match": "api://tpt-backend-local/.default",
          "claims": {
            "aud": "tpt-backend-local",
            "idtyp": "app",
            "azp_name": "dev-gcp:appsec:tpt-data-collector"
          }
        }
      ]
    }
  ]
}
