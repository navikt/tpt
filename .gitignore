# =============================================================================
# navikt/tpt — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
**/.DS_Store
.AppleDouble
.LSOverride

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Mock generator — Node.js tooling
# ---------------------------------------------------------------------------
# Dependencies are installed locally by scripts/generate-mocks.sh.
# Reproducible from scripts/package.json — do not commit.
scripts/node_modules/
scripts/package-lock.json

# ---------------------------------------------------------------------------
# Schemas — fetched at generation time
# ---------------------------------------------------------------------------
# The Nais GraphQL schema is fetched live by `nais api schema` on every
# generator run. At ~250KB it changes frequently with platform releases
# and produces noisy diffs. Re-fetch with: ./scripts/generate-mocks.sh
schemas/*.graphql

# Keep the schemas/ directory itself
!schemas/.gitkeep

# ---------------------------------------------------------------------------
# WireMock generated stubs
# ---------------------------------------------------------------------------
# Generated by scripts/generate-mocks.sh — run this before using Mode B.
# Intentionally not committed: generated output, large, produces noisy diffs.
local-dev/wiremock/mappings/**/*.json
# Keep the directory structure so WireMock has somewhere to mount
!local-dev/wiremock/
!local-dev/wiremock/mappings/
!local-dev/wiremock/mappings/nais/
!local-dev/wiremock/mappings/gcve/
!local-dev/wiremock/mappings/teamkatalogen/
!local-dev/wiremock/mappings/**/.gitkeep

# ---------------------------------------------------------------------------
# Local dev environment
# ---------------------------------------------------------------------------
# .env is generated from .env.example and may contain secrets.
# .env.example IS committed — it documents all required variables.
local-dev/.env

# ---------------------------------------------------------------------------
# Production data dumps (if anyone copies them here by mistake)
# ---------------------------------------------------------------------------
# tpt-backend's runLocalDev can use these files. They contain real
# vulnerability data and must never be committed anywhere.
test-data/mock/mock-vulnerabilities-production.json
test-data/mock/mock-github-data-production.json
# Generic catch for any file ending in -production.json
*-production.json
